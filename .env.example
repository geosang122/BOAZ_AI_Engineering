# .env로 복사해서 채운다 (.env는 git에 올리지 않는다). Python과 docker compose가 같이 읽는다.

# ── LLM: OpenRouter (OpenAI 호환) ──
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=qwen/qwen3-32b
# run_id의 모델 자리. 소문자·숫자·하이픈만
LLM_MODEL_ALIAS=qwen
# 고정할 OpenRouter provider 이름 (allow_fallbacks=false). 예: deepinfra
LLM_PROVIDER=

# ── Agent ──
# toolcall | react | closedbook
AGENT_MODE=toolcall
# none | distractor_only | tool_timeout
AGENT_FAULT=none

# ── 보낼 곳: clickhouse (서버 3개) | duckdb (플랜 B: 서버 없이 runs/의 JSONL + DuckDB) ──
AGENTSCOPE_BACKEND=clickhouse
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# ── ClickHouse (서버와 Python이 같이 씀) ──
CLICKHOUSE_HOST=localhost
CLICKHOUSE_USER=agentscope
CLICKHOUSE_PASSWORD=agentscope
